# Telegram bot used to deliver booking-form enquiries to a private chat.
# Create a bot via @BotFather on Telegram; copy the token it gives you.
TELEGRAM_BOT_TOKEN=

# The private chat/group the bot should post enquiries into.
# Add the bot to a private group, then ask @userinfobot in that group for its id.
# Group ids start with -100.
TELEGRAM_CHAT_ID=

# WhatsApp number the "Message on WhatsApp" button links to.
# International format, digits only, no leading +. Example: 995555354930
NEXT_PUBLIC_WHATSAPP_PHONE=

# Canonical site URL, no trailing slash. Used for canonical links, sitemap
# and Open Graph metadata. Example: https://tamarimikava.com
NEXT_PUBLIC_SITE_URL=
